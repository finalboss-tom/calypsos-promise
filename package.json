{
  "name": "calypsos-promise",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "docs:check": "node tools/docs/check-links.mjs",
    "policy:check": "node tools/policy/check-repository.mjs && pnpm li:check",
    "li:check": "node tools/policy/check-longitudinal-intelligence.mjs",
    "content:check": "pnpm --filter @calypsos-promise/content-schema validate:content && pnpm game:content:validate",
    "check": "pnpm format:check && pnpm docs:check && pnpm policy:check && pnpm economics:check && pnpm content:check && pnpm lint && pnpm typecheck && pnpm test",
    "economics:check": "node tools/policy/check-funding-records.mjs",
    "game:start": "pnpm --filter @calypsos-promise/game start",
    "game:web": "pnpm --filter @calypsos-promise/game web",
    "game:validate": "pnpm --filter @calypsos-promise/game validate:toolchain",
    "game:content:validate": "pnpm --filter @calypsos-promise/game-content validate:package"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.6.2",
    "turbo": "^2.5.5",
    "typescript": "^5.8.3"
  }
}
