{
  "name": "@calypsos-promise/game-content",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./validate": {
      "types": "./src/validate.ts",
      "default": "./dist/validate.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test",
    "validate:package": "pnpm run build && node scripts/validate-package.mjs"
  },
  "dependencies": {
    "@calypsos-promise/content-schema": "workspace:*"
  }
}
