{
  "name": "@calypsos-promise/mcp-forge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": "./src/index.ts",
  "bin": {
    "calypsos-forge-mcp": "./dist/stdio-entry.js"
  },
  "scripts": {
    "build": "pnpm --filter @calypsos-promise/content-schema build && tsc -p tsconfig.json",
    "dev": "pnpm run build && node dist/stdio-entry.js",
    "start": "node dist/stdio-entry.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test"
  },
  "dependencies": {
    "@calypsos-promise/content-schema": "workspace:*"
  }
}
